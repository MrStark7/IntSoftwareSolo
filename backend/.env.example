# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/ta_platform?schema=public"

# JWT
JWT_SECRET="replace-this-with-a-strong-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# APIs académicas UCN
UCN_TOKEN=
UCN_PERIOD=202520

# ─── Modo Demo (solo desarrollo) ────────────────────────────────────────────
# Habilitar el endpoint POST /auth/demo-login para pruebas sin Google OAuth.
# NUNCA establecer DEMO_MODE=true en producción (NODE_ENV=production lo bloquea automáticamente).
DEMO_MODE=false

# Credenciales del Profesor Demo
# El email DEBE terminar en @ucn.cl para que la resolución de identidad funcione correctamente.
# TODO: DEMO_PROFESSOR_RUT es una solución temporal. En el futuro el RUT se obtendrá
#       desde un servicio institucional de identidad y se incluirá en el JWT automáticamente.
DEMO_PROFESSOR_NAME=
DEMO_PROFESSOR_EMAIL=
DEMO_PROFESSOR_RUT=

# Credenciales del Estudiante Demo
# El email DEBE terminar en @alumnos.ucn.cl para la resolución de identidad.
# El perfil académico completo del Demo Student está en src/demo/demo-users.config.ts.
DEMO_STUDENT_NAME=Estudiante Demo
DEMO_STUDENT_EMAIL=demo.student@alumnos.ucn.cl
